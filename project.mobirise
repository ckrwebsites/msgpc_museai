            },
            "@media (max-width: 992px)": {
              ".menu-logo": {
                "display": "none"
              },
              ".navbar-collapse": {
                "padding": "0",
                "padding-top": "1.5rem"
              },
              ".nav-item": {
                "&:before": {
                  "content": "none"
                }
              },
              ".navbar": {
                "padding": "0"
              },
              ".menu-bottom": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column"
              },
              "button.navbar-toggler": {
                "-webkit-align-self": "center",
                "align-self": "center"
              }
            }
