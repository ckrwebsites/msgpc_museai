    "contact.html": {
      "settings": {
        "title": "MSG Painting & Construction - Contact Us",
        "order": 64,
        "meta_descr": "MSG Painting and con"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "-ms-flex-preferred-size": "auto",
              "-webkit-flex-basis": "auto",
              "flex-basis": "auto"
            },
            ".collapse": {
              "justify-content": "space-between !important"
            },
            ".icon-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "1rem"
            },
            ".mbr-iconfont": {
              "cursor": "pointer"
            },
            ".nav-item": {
              "position": "relative",
              "letter-spacing": "2px",
              "font-weight": "200",
              "&:before": {
                "position": "absolute",
                "left": "0px",
                "top": "50%",
                "content": "''",
                "transform": "translateY(-50%)",
                "width": "8px",
                "height": "8px",
                "opacity": "0.5",
                "background": "@primaryColor",
                "border-radius": "50%"
              },
              "& span": {
                "padding-right": "0.4em",
                "line-height": "0.5em",
                "vertical-align": "text-bottom",
                "position": "relative",
                "top": "-0.2em",
