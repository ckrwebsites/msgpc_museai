    "ward.html": {
      "settings": {
        "title": "MSG Painting & Construction - Ward Portfolio",
        "order": 39,
        "meta_descr": "Welcome to MSG Painting & Construction. Thank you so much for visiting our Portfolio of projects. Click on the category links for full image galleries of our works."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "-ms-flex-preferred-size": "auto",
              "-webkit-flex-basis": "auto",
              "flex-basis": "auto"
            },
            ".collapse": {
              "justify-content": "space-between !important"
            },
            ".icon-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "1rem"
            },
            ".mbr-iconfont": {
              "cursor": "pointer"
            },
            ".nav-item": {
              "position": "relative",
              "letter-spacing": "2px",
              "font-weight": "200",
              "&:before": {
                "position": "absolute",
                "left": "0px",
                "top": "50%",
                "content": "''",
                "transform": "translateY(-50%)",
                "width": "8px",
                "height": "8px",
