              "margin-bottom": "2rem"
            },
            ".wrapper::before": {
              "& when (@showArrows)": {
                "content": "'\\e966'",
                "font-family": "MobiriseIcons !important",
                "position": "absolute",
                "font-size": "30px",
                "left": "-15px",
                "top": "30%",
                "color": "@arrowsColor",
                "opacity": "@arrowOpacity"
              }
