        {
          "_name": "article2",
          "_sourceTheme": "impressm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article2\" group=\"Article\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"9\" step=\"1\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/impressm5/components/_images/background1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#c4c4c8\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12 col-lg-{{textWidth}}\">\n\t\t\t\t<div class=\"image-wrap\" mbr-if=\"showImage\">\n\t\t\t\t\t<img src=\"@ADDONS_PATH@/impressm5/components/_images/background7.jpg\" alt>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"text-wrap\">\n\t\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\">\n\t\t\t\t\t\tWHO WE ARE</h4>\n\t\t\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">About MSG Painting &amp; Softwash Co.</h2>\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n\t\t\t\t\t\tMSG Painting &amp; Softwash Co. (MSG PC) is a Christian-Based Company, owned by Michael and Shannon Gardner. We are Fully Insured and have Excellent References &amp; Competitive Rates with the promise of the BEST Quality Results.MSG PC is located in Clermont, FL. and we service all areas within an approximate 50 mile radius of that area. That includes Minneola, Winter Garden, Groveland, Mascotte, Montverde, Ocoee, Leesburg, Davenport and more. Call to see if we service your area!<br>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "h2, h3, h4, p": {
              "margin": "0"
            },
            ".image-wrap": {
              "width": "100%",
              "margin-bottom": "28px",
              "img": {
                "width": "100%",
                "height": "auto"
              }
            },
            ".text-wrap": {
              "margin-top": "10px",
              "margin-bottom": "30px"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "22px"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "5px"
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-bottom": "10px",
              "text-align": "left"
            }
          },
          "_cid": "t4HwtuJx0e",
