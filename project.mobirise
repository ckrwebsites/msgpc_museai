            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "h4": {
              "position": "relative",
              "width": "fit-content",
              "display": "inline-block",
              "padding-left": "50px",
              "&:before": {
                "position": "absolute",
                "content": "''",
                "left": "0px",
                "top": "55%",
                "bottom": "0",
                "width": "35px",
                "height": "1px",
                "background": "@linecolor"
              }
            },
            ".card": {
              "background": "@cardColor",
              "padding": "2rem"
            },
            "span": {
              "font-size": "3rem",
              "opacity": "0.2",
              "color": "@iconColor"
            },
            ".user_text": {
              "color": "#101019",
              "text-align": "left"
            },
            "@media (max-width: 767px)": {
              ".card": {
                "padding": "1rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".user_name, .align": {
              "color": "#8f2020",
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"testimonials04 testimonials04 dinerm4_testimonials04\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"8\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Name\" name=\"showTitle\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Line\" name=\"linecolor\" value=\"#8f2020\" selected condition=\"showTitle\">\n\t\t<input type=\"color\" title=\"Icon\" name=\"iconColor\" value=\"#ffffff\" selected>\n\t\t<input type=\"color\" title=\"Card\" name=\"cardColor\" value=\"#ffffff\" selected>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-4.jpg\" parallax>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ebeff2\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-4.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"mbr-black col-md-12 col-lg-10\">\n\n\t\t\t\t<div class=\"card\">\n\t\t\t\t\t<div class=\"user_text pb-3\">\n\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont mobi-mbri-quote-left mobi-mbri\" style=\"color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n\n\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".user_text\">MSG Painting did amazing work for us here at Glen Arbor! We couldn’t believe how fast they were able to complete such a large exterior project – 14 BUILDINGS – and how full of quality the paint and workmanship turned out to be. Thank you for great work and professionalism to the team of MSG!<br></p>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"align\" mbr-if=\"showTitle\">\n\t\t\t\t\t\t<h4 mbr-text class=\"user_name mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_name, .align\">GLEN ARBOR CONDO ASSOCIATION<br>Grand Blanc, Michigan<br></h4>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t</div>\n</section>",
          "_anchor": "testimonials04-jk",
          "_isUserblock": true,
          "_cid": "tsLmZDFlYN",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
