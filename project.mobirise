              },
              ".mbr-section-subtitle": {
                "margin-bottom": "20px"
              },
              ".item-wrap": {
                "line-height": "36px"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "justify-content": "center",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "position": "absolute",
                "right": "10px",
                "left": "auto"
