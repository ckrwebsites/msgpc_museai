              "b": {
                "color": "#ffffff"
              }
            },
            ".mbr-section-subtitle": {
              "font-weight": "700",
              "line-height": "1.1em",
              "margin-bottom": "43px",
              "color": "#000000"
            },
            ".item-wrap": {
              "line-height": "44px"
            },
            "a.text-white": {
              "color": "#a99fc5 !important",
              "&:hover": {
                "color": "#ffffff !important"
              }
            },
            ".item-wrap a, .contacts a": {
              "display": "inline-block",
              "line-height": "1.87",
              "position": "relative",
              "transition": "0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
              "&:before": {
                "width": "0",
                "left": "auto",
                "right": "0",
                "bottom": "5px",
