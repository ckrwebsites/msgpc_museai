              },
              "b": {
                "color": "#ffffff"
              }
            },
            ".mbr-section-subtitle": {
              "font-weight": "700",
              "line-height": "1.1em",
              "margin-bottom": "43px",
              "color": "#000000"
            },
            ".item-wrap": {
              "line-height": "44px"
            },
            "a.text-white": {
              "color": "#a99fc5 !important",
              "&:hover": {
                "color": "#ffffff !important"
              }
            },
            ".item-wrap a, .contacts a": {
              "display": "inline-block",
              "line-height": "1.87",
              "position": "relative",
              "transition": "0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
              "&:before": {
                "width": "0",
                "left": "auto",
                "right": "0",
                "bottom": "5px",
                "height": "1px",
                "content": "\"\"",
                "position": "absolute",
                "transition": "width 0.2s linear",
                "background": "#ffffff"
              },
              "&:hover::before": {
                "left": "0",
                "width": "100%",
                "right": "auto"
              }
            },
            ".image": {
              "margin-top": "30px",
              "max-width": "200px",
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            },
            "@media (max-width: 991px)": {
              ".row > [class*=\"col\"]": {
                "padding-left": "1rem",
                "padding-right": "1rem"
              },
              ".footer_col_logo": {
                "width": "100%"
              },
              ".footer_col": {
                "width": "33.3%"
              },
              ".image": {
                "margin-bottom": "40px"
              },
              ".contacts": {
                "margin-top": "30px",
                "margin-bottom": "28px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "20px"
              },
              ".item-wrap": {
                "line-height": "36px"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "justify-content": "center",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "position": "absolute",
                "right": "10px",
                "left": "auto"
              },
              ".footer_col": {
                "margin-top": "40px",
                "width": "100%"
              },
              ".image": {
                "margin": "auto",
                "margin-top": "30px"
              }
            }
          },
