          "_name": "gallery2",
          "_sourceTheme": "appm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery10\" group=\"Sliders & Galleries\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <input type=\"id\" name=\"sliderId\">\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverse\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/appm5/components/_images/background6.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div class=\"main-container-text\" mbr-if=\"showLabel || showTitle\">\n        <h3 class=\"label-text mbr-fonts-style align-center mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".label-text\"><b>FEATURED WORK</b></h3>\n        <h3 class=\"item-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-1\" data-app-selector=\".item-title\" mbr-if=\"showTitle\">\n           <b>See our <a href=\"index.html\" class=\"text-info\">Portfolio</a></b></h3>\n    </div>\n    <div class=\"main-container col-12\" mbr-class=\"{'row-reverse' : reverse}\">\n        <div class=\"card-container col-12 col-md-6\">\n            <div class=\"col-12 card\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/exterior-4-min-1024x768.png\" alt>\n                </div>\n            </div>\n        </div>\n        <div class=\"cards-container col-12 col-md-6\">\n            <div class=\"col-12 col-md-6 card\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/cng-9373-940x625.jpeg\" alt>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 card\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/exterior-13-940x674.jpeg\" alt>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 card\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/img-9091-940x705.jpg\" alt>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 card\">\n                <div class=\"item-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/cng-9356-940x625.jpeg\" alt>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</section>",
          "_cid": "sUqwT6GUUe",
          "_anchor": "gallery2-h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afeatures6",
          "_sourceTheme": "solarm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Image Caption\" name=\"showCaption\" checked>\n        <input type=\"checkbox\" title=\"Image Text\" name=\"showImgText\" checked condition=\"showCaption\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/solarm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md col-text\">\n                <div class=\"text-wrapper\">\n                    <p class=\"label-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".label-text\">\n                        <b>MSG Painting &amp; Softwash Co.</b></p>\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>25 Years of Experience in the Painting and Softwash Industry</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">MSG Painting &amp; Softwash Co. (MSG PC) is a Christian-Based Company, owned by Michael and Shannon Gardner. We are Fully Insured and have Excellent References &amp; Competitive Rates with the promise of the BEST Quality Results.\n<br>\n<br>MSG Painting and Softwash Co. is located in Clermont, FL. and Our residential division services 50 miles. Our commercial and government division services the entire state of Florida. Call to see if we service your area!&nbsp;<br></p>\n                  \n                    <div class=\"btn-container\">\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"about.html\" data-app-placeholder=\"Type Text\">READ MORE</a> <a class=\"btn btn-primary-outline\" href=\"tel:+1-352-3633263\" data-app-placeholder=\"Type Text\">CALL NOW</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-{{imageWidth}} image-wrapper\">\n                <div class=\"img-caption-container\">\n                    <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-31-at-5.21.06-pm-1164x1552.jpeg\" alt=\"Mobirise\">\n                    <div class=\"img-caption\" mbr-if=\"showCaption\">\n                        <p class=\"img-label-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".img-label-text\">\n                            <b>FOUNDERS</b></p>\n                        <p class=\"img-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showImgText\" data-app-selector=\".img-text\">\n                            Michael &amp; Shannon Gardner\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".row": {},
            ".type1": {
              "width": "35%",
              "display": "block",
              "margin": "0px auto"
            },
            ".image-wrapper": {
              "display": "flex",
              "@media (max-width: 991px)": {
                "padding-top": "30px",
                "padding-bottom": "30px"
              },
              "@media (min-width: 992px)": {
                "padding": "30px",
                "& when (@reverseContent)": {
                  "padding-right": "3rem"
                },
                "& when not (@reverseContent)": {
                  "padding-left": "3rem"
                }
              },
              ".img-caption-container": {
                "position": "relative",
                "display": "flex"
              },
              "img": {
                "width": "auto",
                "max-width": "100%",
                "height": "auto",
                "object-fit": "cover"
              },
              ".img-caption": {
                "position": "absolute",
                "bottom": "0",
                "right": "0",
                "padding": "24px 32px",
                "max-width": "100%",
                "max-height": "100%",
                "background-color": "#ffffff",
                "& when (@bg-type = 'color')": {
                  "background-color": "@bg-value"
                },
                ".img-label-text": {
                  "color": "#F0C48A"
                },
                ".img-text": {
                  "color": "#222222"
                }
              }
            },
            ".col-text": {
              "@media (max-width: 991px)": {
                "padding-top": "30px",
                "padding-bottom": "30px"
              },
              "@media (min-width: 992px)": {
                "padding": "30px",
                "& when (@reverseContent)": {
                  "padding-left": "3rem"
                },
                "& when not (@reverseContent)": {
                  "padding-right": "3rem"
                }
              },
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".label-text": {
              "width": "100%",
              "margin-bottom": "16px",
              "color": "#8b0000",
              "@media (max-width: 767px)": {
                "text-align": "center !important"
              }
            },
            ".mbr-section-title": {
              "width": "100%",
              "margin-bottom": "24px",
              "color": "#222222"
            },
            ".mbr-text": {
              "color": "#555555",
              "width": "100%",
              "margin-bottom": "1.5rem"
            },
            ".btn-container": {
              "width": "100%",
              "margin-top": "14px"
            },
            ".mbr-section-btn": {
              "@media (max-width: 575px)": {
                "display": "flex",
                "flex-wrap": "wrap",
                "& .btn": {
                  "width": "100%"
                }
              }
            },
            ".img-label-text": {
              "color": "#8b0000"
            }
          },
