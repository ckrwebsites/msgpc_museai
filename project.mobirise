          "_name": "menu1",
          "_sourceTheme": "therapym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu therapym4_manu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe, mobirise-icons\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Icons Count\" name=\"widgetCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"3.5\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#200960\">\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#730707\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\">\n            <div class=\"menu-content-left\">\n                <div class=\"info-widget\">\n                    <a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-map-pin mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"location-title mbr-fonts-style\" data-app-selector=\".location-title\" mbr-theme-style=\"display-4\"><br><a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" class=\"text-white text-primary\" target=\"_blank\">4327 S. Highway 27, Suite 250, Clermont, FL 34711&nbsp;</a></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"menu-content-right\">\n                <div class=\"info-widget\">\n                    <a href=\"mailto:sales@msgpc.com\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-letter mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"mailto:sales@msgpc.com\" class=\"text-warning\">sales@msgpc.com</a></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\">\n                    <a href=\"tel:+1-352-3633263\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"tel:+1-352-3633263\" class=\"text-white\">352.363.3263</a></p>\n                    </div>\n                </div>\n\n                <div class=\"icon-wrap\">\n                    <a href=\"https://www.facebook.com/MSGPaintingConstruction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \" mbr-if=\"widgetCount > 0\"></span></a>\n                    <a href=\"https://www.instagram.com/msgpainting/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-instagram mobi-mbri-add-submenu mobi-mbri\" style mbr-if=\"widgetCount > 1\"></span></a>\n                    <a href=\"https://www.youtube.com/user/mnsgardner?reload=9\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon-youtube socicon\" style mbr-if=\"widgetCount > 2\"></span></a>\n                    <a href=\"https://www.linkedin.com/company/msg-painting-construction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-linkedin socicon\" style mbr-if=\"widgetCount > 3\"></span></a>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"menu-bottom\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"https://mobiri.se\">\n                            <img src=\"@ADDONS_PATH@/therapym4/components/_images/logo2.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-7\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\">\n                        <a href=\"https://mobiri.se\" class=\"brand-name mbr-black text-black mbr-bold\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">\n                            TherapyM4\n                        </a>\n                    </span>\n                </div>\n            </div>\n\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            HOME\n                        </a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT</a>\n                    </li>\n\n                    \n\n                    <li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PAINTING</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/testimonials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">TESTIMONIALS</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/photo-gallery.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">OUR WORK</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/media.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">MEDIA</a></li></ul>\n\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-primary\" href=\"bid-request.html\" data-app-placeholder=\"Type Text\">REQUEST ESTIMATE</a></div>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
          "_cid": "ttfIAn4jN3",
          "_anchor": "menu1-ke",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "overflow": "hidden",
            "box-sizing": "border-box",
            ".mbr-section-title": {
              "margin-bottom": "25px",
              "color": "#730707"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "88px",
              "font-weight": "400"
            },
            ".image": {
              "position": "relative",
              "z-index": "0",
              "top": "-50px",
              "img": {
                "z-index": "-1",
                "width": "100%",
                "max-height": "410px",
                "object-fit": "cover"
              }
            },
            ".mbr-gallery-filter": {
              "text-align": "left",
              "padding": "0 20px",
              "border-bottom": "1px solid @borderColor",
              ".btn": {
                "padding": "0 20px 40px",
                "margin": "0",
                "margin-right": "35px",
                "color": "@tagsColor !important",
                "font-weight": "700",
                "text-align": "left",
                "background": "transparent !important",
                "position": "relative",
                "border": "none",
                "min-width": "auto",
                "width": "auto"
              },
              "ul": {
                "display": "block",
                "li": {
                  "position": "relative",
                  "padding": "0"
                }
              },
              "li:not(.active) .btn.active:after, li.active .btn:not(.active):after, .mbr-gallery-filter .btn:hover:after": {
                "content": "\"\"",
                "position": "absolute",
                "left": "0",
                "right": "auto",
                "width": "100%",
                "bottom": "0",
                "height": "11px",
                "background-color": "@activeTabColor",
                "transition": "all 0.3s ease"
              }
            },
            ".mbr-gallery-row": {
              "margin-top": "50px"
            },
            ".mbr-slider .carousel-control": {
              "background": "#1b1b1b"
            },
            ".mbr-slider .carousel-control-prev": {
              "left": "0",
              "margin-left": "2.5rem",
              "border-radius": "4px"
            },
            ".mbr-slider .carousel-control-next": {
              "right": "0",
              "margin-right": "2.5rem",
              "border-radius": "4px"
            },
            ".mbr-slider .modal-body .close": {
              "background": "#1b1b1b"
            },
            ".mbr-gallery-item > div::before": {
              "content": "''",
              "position": "absolute",
              "left": "0",
              "top": "0",
              "width": "100%",
              "height": "100%",
              "background": "@overlayColor",
              "opacity": "0",
              "transition": "0.2s opacity ease-in-out",
              "& when (@gradOverlay)": {
                "background": "linear-gradient(to left, @overlayColor, @overlayColor2) !important"
              }
            },
            ".mbr-gallery-item > div:hover::before": {
              "opacity": "@overlayOpacity !important"
            },
            ".mbr-gallery-title": {
              "transition": "all .3s",
              "position": "absolute",
              "display": "block",
              "font-weight": "700",
              "width": "100%",
              "bottom": "30px",
              "left": "0",
              "text-align": "center",
              "padding": "0 1rem",
              "color": "#fff",
              "background": "transparent"
            },
            "& when (@showIcon)": {
              ".icon-focus": {
                "transition": "all .3s",
                "top": "30%",
                "width": "48px",
                "height": "48px",
                "transform": "translateY(-30%)"
              }
            },
            "& when not (@showIcon)": {
              ".icon-focus": {
                "display": "none"
              }
            },
            ".mbr-gallery-item": {
              "> div img, div:before": {
                "border-radius": "4px",
                "height": "255px"
              },
              "> div": {
                "transition": "all .3s",
                "border-radius": "4px"
              },
              "&:hover": {
                "> div": {
                  "transform": "scale(0.95)"
                }
              }
            },
            ".carousel-control-prev": {
              ".mbri-left:before": {
                "content": "\"\\e90a\""
              }
            },
            ".carousel-control-next": {
              ".mbri-right:before": {
                "content": "\"\\e909\""
              }
            },
            ".modal-body a.close": {
              "border-radius": "0",
              "font-size": "32px",
              "top": "0",
              "right": "0",
              "height": "70px",
              "width": "70px",
              "line-height": "70px"
            },
            "@media (max-width: 991px)": {
              ".mbr-section-subtitle": {
                "margin-bottom": "20px",
                "text-align": "center"
              },
              ".mbr-section-title": {
                "text-align": "center"
              },
              ".image": {
                "top": "auto",
                "height": "420px"
              },
              ".mbr-gallery-filter": {
                ".btn": {
                  "padding": "0 0 22px"
                },
                "ul li": {
                  "margin-bottom": "10px"
                }
              },
              ".mbr-gallery-item": {
                "> div img, div:before": {
                  "height": "auto",
                  "border-radius": "3px"
                },
                "> div": {
                  "border-radius": "3px"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".image": {
                "height": "290px"
              }
            },
            ".mbr-gallery-item > div > span": {
              "color": "#ffe161"
            }
          },
          "_name": "gallery1",
          "_sourceTheme": "voyagem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mbr-gallery mbr-slider-carousel extGallery gallery1 voyagem4_gallery1\" group=\"Sliders & Galleries\" plugins=\"Masonry,Slider,BootstrapCarouselSwipe,Gallery,VimeoVideo\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"8\" inline>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n\t\t<header>Filter</header>\n\t\t<input type=\"color\" title=\"Tags Color\" name=\"tagsColor\" value=\"#003d59\">\n\t\t<input type=\"color\" title=\"Active Tab Color\" name=\"activeTabColor\" value=\"#730707\">\n\t\t<input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#cce4f0\">\n\t\t<header>Gallery</header>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#003d59\">\n\t\t<input type=\"checkbox\" title=\"Gradient Overlay\" name=\"gradOverlay\">\n\t\t<input type=\"color\" title=\"Overlay Color 2\" name=\"overlayColor2\" value=\"#ffffff\" condition=\"gradOverlay\">\n\t\t<input type=\"range\" title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" inline>\n\t\t<input type=\"color\" title=\"Background Color\" name=\"bgColor\" value=\"#ffffff\">\n\t\t<input type=\"checkbox\" title=\"Show Icon\" name=\"showIcon\" checked>\n\t\t<input type=\"gallery\" title=\"Gallery\" name=\"gallery\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"container\" mbr-if=\"showTitle || showSubtitle || showImage\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-12\" mbr-class=\"{'col-lg-5' : showImage, 'col-lg-12' : !showImage}\">\n\t\t\t\t<h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Mullins Project</h3>\n\t\t\t\t<h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">Lorem ipsum dolor sit amet,\n\t\t\t\t\tconsectetur adipisicing elit. Tenetur voluptatem pariatur iure, ad, hic voluptas in. Voluptatibus\n\t\t\t\t\trerum laudantium, sequi earum, et totam modi! Reprehenderit perferendis non sint officiis est.</h4>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-7 col-12\" mbr-if=\"showImage\">\n\t\t\t\t<div class=\"image\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/img-0152-min-1-640x480.jpeg\" alt title>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class=\"gallery__wrap container\">\n\t\t<div mbr-gallery=\"gallery\" mbr-gallery-spacing=\"4\" mbr-gallery-show-bullets mbr-gallery-show-filter></div>\n\t</div>\n</section>",
          "_cid": "t681jkLfEk",
          "_anchor": "gallery1-8a",
          "_protectedParams": [
            "text_all",
            "gallery__filtersTextStyle",
            "gallery__filtersBtnStyle",
            "gallery"
          ],
          "_global": false,
          "_once": false,
          "_params": {
            "text_all": "All",
            "gallery__filtersTextStyle": "display-7",
            "gallery__filtersBtnStyle": "btn-primary-outline",
            "gallery": [
              {
                "tags": "Exterior",
                "videoPreview": "@ADDONS_PATH@/voyagem4/components/_images/gallery/preview.jpg",
                "playVideo": false,
                "videoUrl": "https://www.youtube.com/watch?v=fwkKc6M60-0",
                "image": "@PROJECT_PATH@/assets/images/img-0152-min-640x480.jpg",
                "thumb": "@PROJECT_PATH@/assets/images/img-0152-min-640x480-640x480.jpg",
                "alt": "",
                "title": "",
                "customStyle1": "display-1",
                "caption": "Zittel Project",
