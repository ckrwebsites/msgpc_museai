    "about.html": {
      "settings": {
        "title": "About MSG Painting & Construction - What We Do, Who We Are and Where We Are Going",
        "order": 1,
        "meta_descr": "MSG Painting Company (MSG PC) is a Christian-Based Company, owned by Michael and Shannon Gardner. We are Fully Insured and have Excellent References & Competitive Rates with the promise of the BEST Quality Results."
      },
      "components": [
        {
