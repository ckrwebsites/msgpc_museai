                "content": "\"\"",
                "position": "absolute",
                "transition": "width 0.2s linear",
                "background": "#ffffff"
              },
              "&:hover::before": {
                "left": "0",
                "width": "100%",
                "right": "auto"
              }
            },
            ".image": {
              "margin-top": "30px",
              "max-width": "200px",
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            },
            "@media (max-width: 991px)": {
              ".row > [class*=\"col\"]": {
                "padding-left": "1rem",
                "padding-right": "1rem"
              },
              ".footer_col_logo": {
                "width": "100%"
              },
              ".footer_col": {
                "width": "33.3%"
              },
              ".image": {
                "margin-bottom": "40px"
              },
              ".contacts": {
                "margin-top": "30px",
                "margin-bottom": "28px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "20px"
              },
              ".item-wrap": {
                "line-height": "36px"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "justify-content": "center",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "position": "absolute",
                "right": "10px",
                "left": "auto"
              },
              ".footer_col": {
                "margin-top": "40px",
                "width": "100%"
              },
              ".image": {
                "margin": "auto",
