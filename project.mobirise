          "_name": "slider1",
          "_sourceTheme": "modernm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 modernm4_slider1 clients\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-clients-slider\" data-interval=\"false\" data-bs-interval=\"false\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Slider</header>\n        <input type=\"checkbox\" title=\"Show Arrows\" name=\"showArrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" name=\"arrowsColor\" value=\"#730707\" condition=\"showArrows\">\n        <input type=\"range\" inline title=\"Items\" name=\"slidesCount\" min=\"1\" max=\"20\" step=\"1\" value=\"8\">\n        <input type=\"color\" title=\"Slides Color\" name=\"slidesColor\" value=\"#730707\">\n        <select title=\"Visible Slides\" name=\"visibleSlides\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"8000\" condition=\"showAutoplay\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/modernm4/components/_images/background/backgraund__trend.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://youtu.be/iM-NestDPNQ\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#5eeebb\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity}\">\n    </div>\n    <div mbr-class=\"{'container-fluid' : fullWidth, 'container' : !fullWidth}\" mbr-if=\"showSubtitle || showTitle || showButtons || showArrows\">\n        <div class=\"row wrap\">\n            <div class=\"title__block\" mbr-class=\"{'col-md-6' : (showButtons && showArrows) || !showButtons, 'col-md-12' : !showButtons && !showArrows, 'col-md-8' : !showArrows && showButtons}\" mbr-if=\"showSubtitle || showTitle\">\n                <h4 class=\"mbr-section-subtitle mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">SEE OUR WORK</h4>\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-section-title\">Before&nbsp;<b>&amp; Afters.</b></h2>\n            </div>\n            <div class=\"arrows\" mbr-class=\"{'col-md-8' : !showTitle && !showSubtitle && showButtons, 'col-md-12' : !showTitle && !showSubtitle && !showButtons, 'col-md-2' : (showTitle || showSubtitle) && (showButtons || !showButtons)}\" mbr-if=\"showArrows\"></div>\n            <div class=\"col-md-4 buttons\" mbr-if=\"showButtons\">\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-sm btn-primary\" href=\"#\" data-app-placeholder=\"Type Text\">View Gallery</a></div>\n            </div>\n        </div>\n    </div>\n\n    <div mbr-class=\"{'container-fluid' : fullWidth, 'container' : !fullWidth}\">\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-bs-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" data-bs-interval=\"{{showAutoplay ? interval : 'false'}}\">\n            <div class=\"media-container-row arrows\">\n                <div mbr-class=\"{'col-md-8' : !showTitle && !showSubtitle && showButtons, 'col-md-12' : !showTitle && !showSubtitle && !showButtons, 'col-md-2' : (showTitle || showSubtitle) && (showButtons || !showButtons)}\">\n                    <div class=\"carousel-controls\" mbr-if=\"showArrows\">\n                        <a data-app-prevent-settings class=\"carousel-control carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                            <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-iconfont\"></span>\n                            <span class=\"sr-only visually-hidden\">Previous</span>\n                        </a>\n                        <a data-app-prevent-settings class=\"carousel-control carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                            <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\n                            <span class=\"sr-only visually-hidden\">Next</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"carousel-inner\" mbr-list mbr-list-grow=\"slidesCount\" data-visible=\"{{visibleSlides}}\">\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-12-at-4.00.36-pm-1227x1227.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-16-at-5.55.59-pm-1-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-12-at-3.46.48-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-31-at-6.22.01-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-12-at-4.06.19-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n            <div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-16-at-3.38.17-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-31-at-6.26.40-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item \">\n                    <div class=\"media-container-row\">\n                        <div class=\"col-md-12\">\n                            <div class=\"wrap-img \">\n                                <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-05-16-at-3.20.32-pm-1920x1920.jpg\" class=\"img-responsive clients-img\" alt title>\n                                <div class=\"icon__block\">\n                                    <span mbr-icon class=\"mbr-iconfont mbr-iconfont-1 mbri-plus\"></span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls d-md-none\" mbr-if=\"showArrows\">\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                    <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-iconfont\"></span>\n                    <span class=\"sr-only visually-hidden\">Previous</span>\n                </a>\n                <a data-app-prevent-settings class=\"carousel-control carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                    <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-iconfont\"></span>\n                    <span class=\"sr-only visually-hidden\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
