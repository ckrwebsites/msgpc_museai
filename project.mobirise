            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"extFeatures\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&amp;&amp;bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Underline\" name=\"showUnderline\" condition=\"showTitle\">\n        <input type=\"color\" title=\"Underline Color\" name=\"underlineColor\" value=\"#232323\" condition=\"showUnderline&amp;&amp;showTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Show Numbers\" name=\"showNumbers\">\n        <select title=\"Process count\" name=\"processCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected=\"\">3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <input type=\"color\" title=\"Card Hover\" name=\"hoverColor\" value=\"#ebeff2\">\n        <input type=\"color\" title=\"Card Background\" name=\"cardBg\" value=\"#c4c4c8\">\n        <input type=\"checkbox\" title=\"Show Arrows\" name=\"showArrows\">\n        <input type=\"color\" title=\"Arrows Color\" name=\"arrowsColor\" value=\"#232323\" condition=\"showArrows\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"arrowOpacity\" min=\"0.1\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"showArrows\">\n       \n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background8.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&amp;&amp;bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&amp;&amp;bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container justify-content-center\">\n        <h2 class=\"mbr-fonts-style mbr-section-title align-center\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title,.underline\"><i><b>\"We've Got You Covered\"</b></i></h2>\n        <div class=\"underline align-center\" mbr-if=\"showUnderline&amp;&amp;showTitle\">\n             <div class=\"line\"></div>\n        </div>\n        \n        <h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-light pt-3\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Lorem ipsum dolor amet, consecte tempor incididunt</h3>\n        <div class=\"media-container-row justify-content-center align-items-start main-wrapper\">\n            <div class=\"icon-main col-lg-3 col-md-6 col-12 without-before\">\n                <div class=\"process-icon\">\n                    <div class=\"wrapper-without-before\">\n                      <span class=\"icon-container\">\n                          <a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" target=\"_blank\">\n                              <span mbr-icon=\"\" class=\"icon-wrapper mbr-iconfont mdi-communication-location-on\" data-app-selector=\".mbr-iconfont\" mbr-style=\"{'background-color': cardBg}\" style=\"color: rgb(139, 0, 0); fill: rgb(139, 0, 0);\"></span></a>\n                          <span mbr-text=\"\" class=\"icon-number mbr-fonts-style\" data-app-selector=\".icon-number\" mbr-if=\"showNumbers\" mbr-style=\"{'background-color': cardBg}\" mbr-theme-style=\"display-7\">1</span>\n                      </span>\n                    </div>\n                    <h1 class=\"subicon-title mbr-fonts-style\" data-app-selector=\".subicon-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">ADDRESS</h1>\n                    <p class=\"subicon-text mbr-fonts-style\" data-app-selector=\".subicon-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"><b><a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" class=\"text-primary\" target=\"_blank\">4327 S. Highway 27, Suite 250, </a><br><a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" class=\"text-primary\" target=\"_blank\">Clermont, FL 34711</a></b><br></p>\n                </div>\n            </div>\n\n            <div class=\"icon-main col-lg-3 col-md-6 col-12\" mbr-if=\"processCount>1\">\n                <div class=\"process-icon\">\n                    <div class=\"wrapper\">\n                      <span class=\"icon-container\">\n                          <a href=\"tel:+1-352-3633263\">\n                            <span mbr-icon=\"\" class=\"mbr-iconfont icon-wrapper mdi-hardware-smartphone\" data-app-selector=\".mbr-iconfont\" mbr-style=\"{'background-color': cardBg}\" style=\"color: rgb(139, 0, 0); fill: rgb(139, 0, 0);\"></span></a>\n                          <span mbr-text=\"\" class=\"icon-number mbr-fonts-style\" data-app-selector=\".icon-number\" mbr-if=\"showNumbers\" mbr-style=\"{'background-color': cardBg}\" mbr-theme-style=\"display-7\">2</span>\n                      </span>\n                    </div>\n                    <h1 class=\"subicon-title mbr-fonts-style\" data-app-selector=\".subicon-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">CALL US</h1>\n                    <p class=\"subicon-text mbr-fonts-style\" data-app-selector=\".subicon-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"><b><a href=\"tel:+1-352-3633263\" class=\"text-primary\">352.363.3263</a>\n<br></b>\n<br></p>\n                </div>\n            </div>\n            \n            <div class=\"icon-main col-lg-3 col-md-6 col-12 third-elem\" mbr-if=\"processCount>2\">\n                <div class=\"process-icon\">\n                    <div class=\"wrapper\">\n                      <span class=\"icon-container\">\n                          <a href=\"mailto:sales@msgpc.com\">\n                            <span mbr-icon=\"\" class=\"mbr-iconfont icon-wrapper socicon-mail socicon\" data-app-selector=\".mbr-iconfont\" mbr-style=\"{'background-color': cardBg}\" style=\"color: rgb(139, 0, 0); fill: rgb(139, 0, 0);\"></span></a>\n                          <span mbr-text=\"\" class=\"icon-number mbr-fonts-style\" data-app-selector=\".icon-number\" mbr-if=\"showNumbers\" mbr-style=\"{'background-color': cardBg}\" mbr-theme-style=\"display-7\">3</span>\n                      </span>\n                    </div>\n                    <h1 class=\"subicon-title mbr-fonts-style\" data-app-selector=\".subicon-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">EMAIL US</h1>\n                    <p class=\"subicon-text mbr-fonts-style\" data-app-selector=\".subicon-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\"><a href=\"mailto:sales@msgpc.com\" class=\"text-primary\">sales@msgpc.com</a><br></p>\n                </div>\n            </div>\n                \n            <div class=\"icon-main col-lg-3 col-md-6 col-12\" mbr-if=\"processCount>3\">\n                  <div class=\"process-icon\">\n                      <div class=\"wrapper\">\n                        <span class=\"icon-container\">\n                            <a href=\"https://mobiri.se\">\n                              <span mbr-icon=\"\" class=\"mbr-iconfont icon-wrapper mbri-sun2\" data-app-selector=\".mbr-iconfont\" mbr-style=\"{'background-color': cardBg}\"></span></a>\n                            <span mbr-text=\"\" class=\"icon-number mbr-fonts-style\" data-app-selector=\".icon-number\" mbr-if=\"showNumbers\" mbr-style=\"{'background-color': cardBg}\" mbr-theme-style=\"display-7\">4</span>\n                        </span>\n                      </div>\n                      <h1 class=\"subicon-title mbr-fonts-style\" data-app-selector=\".subicon-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">DESIGN</h1>\n                      <p class=\"subicon-text mbr-fonts-style\" data-app-selector=\".subicon-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\">Lorem ipsum dolor sit amet, consectetur adipisicing elit. <a class=\"text-ptimary\" href=\"https://mobiri.se\">Learn more</a></p>\n                  </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "extFeatures10-ob",
          "_isUserblock": true,
          "_cid": "ty7FH6TXP6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "footer2",
          "_sourceTheme": "firmm4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"firmm4_footer2\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footer\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\">\n        <select name=\"showLogo\" title=\"Logo\">\n            <option value=\"1\" selected>Logo</option>\n            <option value=\"2\">Brand</option>\n        </select>\n        <input type=\"range\" inline title=\"Logo Size\" name=\"logoSize\" min=\"1\" max=\"10\" step=\"1\" value=\"6\" condition=\"showLogo == 1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/firmm4/components/_images/background/background.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ebeff2\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    \n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"footer_col_logo\">\n                <div class=\"logo_wrap\" mbr-if=\"showLogo == 1\">\n                    <a href=\"https://msgpc.com\">\n                        <img src=\"@PROJECT_PATH@/assets/images/msg20202620logo20wanna20color20ds-892x436.png\" alt=\"Mobirise\">\n                       \n                    </a>\n                </div>\n                <div class=\"brand_wrap\" mbr-if=\"showLogo == 2\">\n                    <h3 mbr-theme-style=\"display-5\" class=\"brand_name mb-0\" data-app-selector=\".brand_name\"><b>MSG Painting and Construction</b></h3>\n                </div>\n                <div class=\"contacts\" mbr-if=\"showContacts\">\n                    <p class=\"contacts_mail mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contacts_mail\"><b>E-mail:</b> <a href=\"#\" class=\"text-white\">sales@msgpc.com</a></p>\n                    <p class=\"contacts_phone mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contacts_phone\"><b>Phone:</b> <a href=\"#\" class=\"text-white\">352.363.3263</a></p>\n                </div>\n                <div class=\"image\" mbr-if=\"showImage\">\n                    <img src=\"@PROJECT_PATH@/assets/images/msg%20pc%202022%20logo%20final%20(1)-400x208.png\" alt>\n                </div>\n            </div>   \n            <div class=\"footer_col\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>MENU</b>\n                </h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com\" class=\"text-primary\"><b>Home</b></a></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/about.html\" class=\"text-primary\"><b>About</b></a></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/services.html\" class=\"text-primary\"><b>Services</b></a></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/testimonials.html\" class=\"text-primary\"><b>Testimonials</b></a></li>\n                    <li class=\"mbr-text item-wrap\"><b>Our Work</b></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/media.html\" class=\"text-primary\"><b>Media</b></a></li>\n                </ul>\n            </div>\n            <div class=\"footer_col\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>COMPANY</b>\n                </h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/contact.html\" class=\"text-primary\"><b>Contact Us</b></a></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/bid-request.html\" class=\"text-primary\"><b>Bid Request</b></a></li>\n                </ul>\n            </div>\n            <div class=\"footer_col\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                    <b>LEGAL</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/terms.html\" class=\"text-primary\"><b>Terms and Conditions</b></a></li><a href=\"https://msgpc.com/msgpc/terms.html\" class=\"text-primary\">\n                    </a><li class=\"mbr-text item-wrap\"><a href=\"https://msgpc.com/policy.html\" class=\"text-primary\"><b>Privacy Policy</b></a></li>\n                    </ul>\n                <a href=\"https://msgsoftwash.com\" target=\"_blank\"></a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".footer_col_logo": {
              "width": "40%"
            },
            ".footer_col": {
              "width": "20%"
            },
            ".list": {
              "list-style": "none",
              "padding": "0",
              "margin": "0",
              "color": "#730707"
            },
            ".logo_wrap": {
              "max-width": "(@logoSize * 15%)",
              "img": {
                "width": "100%",
                "max-height": "300px"
              }
            },
            ".brand_name": {
              "color": "#ffffff"
            },
            ".contacts": {
              "margin-top": "46px",
              "p": {
                "line-height": "33px",
                "margin-bottom": "0"
              },
              "b": {
                "color": "#ffffff"
              }
            },
            ".mbr-section-subtitle": {
              "font-weight": "700",
              "line-height": "1.1em",
              "margin-bottom": "43px",
              "color": "#000000"
            },
            ".item-wrap": {
              "line-height": "44px"
            },
            "a.text-white": {
              "color": "#a99fc5 !important",
              "&:hover": {
                "color": "#ffffff !important"
              }
            },
            ".item-wrap a, .contacts a": {
              "display": "inline-block",
              "line-height": "1.87",
              "position": "relative",
              "transition": "0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
              "&:before": {
                "width": "0",
                "left": "auto",
                "right": "0",
                "bottom": "5px",
                "height": "1px",
                "content": "\"\"",
                "position": "absolute",
                "transition": "width 0.2s linear",
                "background": "#ffffff"
              },
              "&:hover::before": {
                "left": "0",
                "width": "100%",
                "right": "auto"
              }
            },
            ".image": {
              "margin-top": "30px",
              "max-width": "200px",
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            },
            "@media (max-width: 991px)": {
              ".row > [class*=\"col\"]": {
                "padding-left": "1rem",
                "padding-right": "1rem"
              },
              ".footer_col_logo": {
                "width": "100%"
              },
              ".footer_col": {
                "width": "33.3%"
              },
              ".image": {
                "margin-bottom": "40px"
              },
              ".contacts": {
                "margin-top": "30px",
                "margin-bottom": "28px"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "20px"
              },
              ".item-wrap": {
                "line-height": "36px"
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "justify-content": "center",
                "text-align": "center"
              },
              ".mbr-section-btn": {
                "position": "absolute",
                "right": "10px",
                "left": "auto"
              },
              ".footer_col": {
                "margin-top": "40px",
                "width": "100%"
              },
              ".image": {
                "margin": "auto",
                "margin-top": "30px"
              }
            }
          },
          "_cid": "ttMr2GF1ty",
          "_anchor": "footer2-n9",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footer",
          "_params": {}
        },
        {
          "_name": "footer01",
          "_sourceTheme": "softwarem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/softwarem4/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ebeff2\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center mbr-white\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\"></p><p>\n                    © Copyright 2023 <a href=\"https://msgpc.com\" class=\"text-primary\"><b>MSG Painting &amp; Construction LLC</b></a> - All Rights Reserved&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; Designed by <a href=\"https://ckrwebsites.com\" class=\"text-primary\"><b>CKR Websites</b></a></p><p></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".media-container-row .mbr-text": {
              "color": "#000000"
            },
            "P": {
              "color": "#000000"
            }
          },
          "_cid": "ttMCGQrGA2",
          "_anchor": "footer01-na",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "stevens.html": {
      "settings": {
        "title": "MSG Painting & Construction - Stevens Portfolio",
        "order": 37,
        "meta_descr": "Welcome to MSG Painting & Construction. Thank you so much for visiting our Portfolio of projects. Click on the category links for full image galleries of our works."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "-ms-flex-preferred-size": "auto",
              "-webkit-flex-basis": "auto",
              "flex-basis": "auto"
            },
            ".collapse": {
              "justify-content": "space-between !important"
            },
            ".icon-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "1rem"
            },
            ".mbr-iconfont": {
              "cursor": "pointer"
            },
            ".nav-item": {
              "position": "relative",
              "letter-spacing": "2px",
              "font-weight": "200",
              "&:before": {
                "position": "absolute",
                "left": "0px",
                "top": "50%",
                "content": "''",
                "transform": "translateY(-50%)",
                "width": "8px",
                "height": "8px",
                "opacity": "0.5",
                "background": "@primaryColor",
                "border-radius": "50%"
              },
              "& span": {
                "padding-right": "0.4em",
                "line-height": "0.5em",
