              }
            }
          },
          "_name": "menu1",
          "_sourceTheme": "therapym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu therapym4_manu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe, mobirise-icons\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Icons Count\" name=\"widgetCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"3.5\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#200960\">\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#730707\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\">\n            <div class=\"menu-content-left\">\n                <div class=\"info-widget\">\n                    <a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-map-pin mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"location-title mbr-fonts-style\" data-app-selector=\".location-title\" mbr-theme-style=\"display-4\"><br><a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" class=\"text-white text-primary\" target=\"_blank\">4327 S. Highway 27, Suite 250, Clermont, FL 34711&nbsp;</a></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"menu-content-right\">\n                <div class=\"info-widget\">\n                    <a href=\"mailto:sales@msgpc.com\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-letter mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"mailto:sales@msgpc.com\" class=\"text-warning\">sales@msgpc.com</a></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\">\n                    <a href=\"tel:+1-352-3633263\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"tel:+1-352-3633263\" class=\"text-white\">352.363.3263</a></p>\n                    </div>\n                </div>\n\n                <div class=\"icon-wrap\">\n                    <a href=\"https://www.facebook.com/MSGPaintingConstruction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \" mbr-if=\"widgetCount > 0\"></span></a>\n                    <a href=\"https://www.instagram.com/msgpainting/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-instagram mobi-mbri-add-submenu mobi-mbri\" style mbr-if=\"widgetCount > 1\"></span></a>\n                    <a href=\"https://www.youtube.com/user/mnsgardner?reload=9\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon-youtube socicon\" style mbr-if=\"widgetCount > 2\"></span></a>\n                    <a href=\"https://www.linkedin.com/company/msg-painting-construction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-linkedin socicon\" style mbr-if=\"widgetCount > 3\"></span></a>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"menu-bottom\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"https://mobiri.se\">\n                            <img src=\"@ADDONS_PATH@/therapym4/components/_images/logo2.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-7\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\">\n                        <a href=\"https://mobiri.se\" class=\"brand-name mbr-black text-black mbr-bold\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">\n                            TherapyM4\n                        </a>\n                    </span>\n                </div>\n            </div>\n\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            HOME\n                        </a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT</a>\n                    </li>\n\n                    \n\n                    <li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PAINTING</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/testimonials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">TESTIMONIALS</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/photo-gallery.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">OUR WORK</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/media.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">MEDIA</a></li></ul>\n\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-primary\" href=\"bid-request.html\" data-app-placeholder=\"Type Text\">REQUEST ESTIMATE</a></div>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
          "_cid": "ttfIAn4jN3",
          "_anchor": "menu1-ke",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-wrap": {
              "width": "29.6rem",
              "height": "29.6rem",
              "position": "relative"
            },
            ".card": {
              "border": "2px solid #17171A",
              "border-radius": "0",
              "width": "14.8rem",
              "height": "14.8rem"
            },
            ".right": {
              "position": "absolute",
              "top": "1px",
              "right": "2px"
            },
            ".left": {
              "position": "absolute",
              "bottom": "1px",
              "left": "0"
            },
            ".item-btn": {
              "width": "10.6rem",
              "height": "10.6rem"
            },
            ".align-bottom": {
              "margin-left": "3px",
              "margin-bottom": "13px",
              "padding-bottom": "10px"
            },
            "@media (min-width: 1000px)": {
              ".content-wrap": {
                "flex-wrap": "nowrap"
              },
              ".main-content": {
                "width": "75%",
                "padding-left": "3rem"
              }
            },
            "@media (max-width: 999px)": {
              ".content-wrap": {
                "flex-wrap": "wrap"
              },
              ".main-content": {
                "width": "75%",
                "padding-left": "1rem",
                "p": {
                  "width": "70%"
                }
              },
              ".card-wrap": {
                "width": "20.8rem",
                "height": "20.8rem",
                "position": "absolute",
                "right": "0.5rem",
                "top": "0.5rem"
              },
              ".card": {
                "width": "10.4rem",
                "height": "10.4rem"
              },
              ".item-btn": {
                "width": "8rem",
                "height": "8rem",
                "margin-left": "5rem",
                "margin-top": "-1.2rem"
              }
            },
            "@media (max-width: 769px)": {
              ".main-content": {
                "width": "100%",
                "text-align": "center",
                "p": {
                  "width": "100%"
                }
              },
              ".add-content": {
                "display": "none"
              },
              ".item-btn": {
                "width": "6.9rem",
                "height": "6.9rem",
                "margin": "auto"
              }
            },
            "@media (max-width: 600px)": {
              ".mbr-section-title": {
                "letter-spacing": "-1px"
              }
            },
            ".mbr-section-title a": {
              "color": "#9b9ba5"
            },
            ".mbr-text": {
              "color": "#8b0000"
            },
            "P": {
              "color": "#8b0000",
              "text-align": "left"
            },
            ".mbr-section-subtitle": {
              "color": "#8b0000",
              "text-align": "right"
            }
          },
          "_name": "features2",
          "_sourceTheme": "housem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#c4c4c8\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\n        <div class=\"content-wrap d-flex\">\n\n            <div class=\"main-content\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                    Get a&nbsp;<a href=\"index.html\" class=\"text-primary\">free estimate</a>&nbsp;today!</h4>\n\n                <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\"><br>Please fill in the requested information and give us an idea of what your project entails. We will contact you within 24 hours to discuss the next step in your FREE ESTIMATE!\n<br>\n<br>If you would like to speak to someone during business hours, please call (352) 363-3263.</p>\n\n                <div mbr-buttons mbr-theme-style=\"display-2\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\"><a href=\"bid-request.html#formbuilder-3u\" class=\"btn btn-primary item-btn rounded-circle\" target=\"_blank\" data-app-placeholder=\"Type Text\">\n                            <span>0% for 12 Months&nbsp;</span><span><br></span>\n                        </a></div>\n\n            </div>\n\n            <div class=\"add-content\">\n\n                <div class=\"card-wrap\">\n\n                    <div class=\"card align-items-start justify-content-center ps-4 right\">\n                        <div class=\"d-flex\">\n                            <h4 class=\"mbr-section-title mbr-fonts-style align-left\" mbr-theme-style=\"display-1\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">100+</h4>\n                            <p class=\"mbr-text mbr-fonts-style align-left align-self-end align-bottom\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">Projects</p>\n                        </div>\n\n                        <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\">Residential &amp; Commercial</p>\n\n                        </div>\n\n                    <!-- <div class=\"clearfix\"></div> -->\n\n                    <div class=\"card align-items-start justify-content-center ps-4 left\">\n                        <div class=\"d-flex\">\n                            <h4 class=\"mbr-section-title mbr-fonts-style align-left\" mbr-theme-style=\"display-1\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">15</h4>\n                            <p class=\"mbr-text mbr-fonts-style align-left align-self-end align-bottom\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\" data-app-selector=\".mbr-section-subtitle\">years</p>\n                        </div>\n\n                        <p class=\"mbr-text mbr-fonts-style align-left\" mbr-theme-style=\"display-7\">of Business</p>\n\n                        </div>\n                    </div>\n\n                </div>\n        </div>\n    </div>\n</section>",
          "_cid": "t4NtOKzuMd",
          "_anchor": "features2-3v",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "formbuilder",
          "_isSecondary": true,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@customStyle)": {
              ".form-control, .field-input": {
                "padding": "0.5rem",
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&::-webkit-input-placeholder, &::-webkit-input-placeholder": {
                  "color": "@formPlaceholder"
                },
                "&:-moz-placeholder, &:-moz-placeholder": {
                  "color": "@formPlaceholder"
                },
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover",
                  "color": "@formFocusText",
                  "box-shadow": "none",
                  "outline": "none",
                  "&::-webkit-input-placeholder, &::-webkit-input-placeholder": {
                    "color": "@formFocusPlaceholder"
                  },
                  "&:-moz-placeholder, &:-moz-placeholder": {
                    "color": "@formFocusPlaceholder"
                  }
                }
              },
              ".jq-number__spin:hover, .jq-number__spin:focus": {
                "background-color": "@fieldHover",
                "border-color": "@borderHover",
                "color": "contrast(@formText, #000000, #ffffff, 30%)",
                "box-shadow": "none",
                "outline": "none"
              },
              ".jq-number__spin": {
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow, .jq-number__spin.minus:hover:after, .jq-number__spin.plus:hover:after": {
                "border-top-color": "@fieldColor",
                "border-bottom-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow, .jq-number__spin.minus:after, .jq-number__spin.plus:after": {
                "border-top-color": "@fieldHover",
                "border-bottom-color": "@fieldHover"
              }
            },
            "& when (@customStyle), (@disableElements)": {
              "input::-webkit-clear-button": {
                "display": "none"
              },
              "input::-webkit-inner-spin-button": {
                "display": "none"
              },
              "input::-webkit-outer-spin-button": {
                "display": "none"
              },
              "input::-webkit-calendar-picker-indicator": {
                "display": "none"
              }
            },
            "H4": {
              "color": "#8b0000",
              "text-align": "center"
            }
          },
          "_name": "formbuilder",
          "_sourceTheme": "housem5",
          "_customHTML": "<section class=\"form\" group=\"Form\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <header>Style</header>\n        <input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\" checked>\n        <input type=\"checkbox\" name=\"disableElements\" title=\"Disable Control\">\n        <input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n        <input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#8b0000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#8b0000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#c4c4c8\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusText\" title=\"Text Focus\" value=\"#ebeff2\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#000000\" condition=\"customStyle\">\n        <input type=\"color\" name=\"formFocusPlaceholder\" title=\"Placeholders Focus\" value=\"#ebeff2\" condition=\"customStyle\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Background Image\" value=\"../assets/background.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    <div class=\"container\">\n        <div class=\"row\">\n            <div mbr-form class=\"col-lg-8 mx-auto mbr-form\">\n<!--Formbuilder Form-->\n<form action=\"sales@msgpc.com\" name=\"MSG Painting & Construction Bid Request Form\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thank you for sending us your bid request. We will respond as soon as possible. </div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<h4 mbr-theme-style=\"display-1\" class=\"mbr-fonts-style\">MSG Painting &amp; Softwash Co. Bid Request Form</h4>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<hr>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"row\">\n<div class=\"col\">\n<input type=\"text\" name=\"First Name\" placeholder=\"First Name\" data-form-field=\"First Name\" class=\"form-control text-multiple\" required=\"required\" value>\n</div>\n<div class=\"col\">\n<input type=\"text\" name=\"Last Name\" placeholder=\"Last Name\" data-form-field=\"Last Name\" class=\"form-control text-multiple\" required=\"required\" value>\n</div>\n</div>\n</div>\n<div data-for=\"Address\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"Address\" placeholder=\"Address\" data-form-field=\"Address\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"city\" class=\"col-lg-6 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"city\" placeholder=\"City\" data-form-field=\"city\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"Zip\" class=\"col-lg-6 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"Zip\" placeholder=\"Zip\" data-form-field=\"Zip\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"phone\">\n<input type=\"tel\" name=\"phone\" placeholder=\"Contact Phone\" data-form-field=\"phone\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n</div>\n<div data-for=\"Email\" class=\"col-lg-6 col-md-12 col-sm-12 form-group\">\n<input type=\"text\" name=\"Email\" placeholder=\"Email\" data-form-field=\"Email\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Best Way to Contact\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Best Way to Contact\" class=\"form-control-label mbr-fonts-style\">Best Way to Contact?</label>\n<select name=\"Best Way to Contact\" data-form-field=\"Best Way to Contact\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control form-select\">\n<option value=\"Phone\">Phone</option>\n<option value=\"Email\">Email</option>\n<option value=\"Text\">Text</option>\n</select>\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Commercial Project\" class=\"mbr-fonts-style\">Project Type*</label>\n</div>\n<div data-for=\"Interior\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Interior\" data-form-field=\"Interior\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Interior\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Interior</label>\n</div>\n<div data-for=\"Exterior\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Exterior\" data-form-field=\"Exterior\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Exterior\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Exterior</label>\n</div>\n<div data-for=\"Powerwashing\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Powerwashing\" data-form-field=\"Powerwashing\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Powerwashing\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Powerwashing</label>\n</div>\n<div data-for=\"Pool/Deck/Lanai\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Pool/Deck/Lanai\" data-form-field=\"Pool/Deck/Lanai\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Pool/Deck/Lanai\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Pool/Deck/Lanai</label>\n</div>\n<div data-for=\"Cabinet Painting\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Cabinet Painting\" data-form-field=\"Cabinet Painting\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Cabinet Painting\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Cabinet Painting</label>\n</div>\n<div data-for=\"Color Consultation\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Color Consultation\" data-form-field=\"Color Consultation\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Color Consultation\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Color Consultation</label>\n</div>\n<div data-for=\"Commercial Project\" class=\"form-check ms-2\">\n<input type=\"checkbox\" value=\"Yes\" name=\"Commercial Project\" data-form-field=\"Commercial Project\" mbr-theme-style=\"display-7\" class=\"form-check-input\">\n<label mbr-text for=\"Commercial Project\" mbr-theme-style=\"display-7\" class=\"form-check-label\">Commercial Project</label>\n</div>\n</div>\n<div data-for=\"Where did you hear about us?\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Where did you hear about us?\" class=\"form-control-label mbr-fonts-style\">Where did you hear about MSG Painting &amp; Construction?*</label>\n<select name=\"Where did you hear about us?\" data-form-field=\"Where did you hear about us?\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control form-select\">\n<option value=\"Billboard Advertisement\">Billboard Advertisement</option>\n<option value=\"Google Search\">Google Search</option>\n<option value=\"Instagram\">Instagram</option>\n<option value=\"Facebook\">Facebook</option>\n<option value=\"News Article\">News Article</option>\n<option value=\"Youtube\">Youtube</option>\n<option value=\"Tik Tok\">Tik Tok</option>\n<option value=\"Referral\">Referral</option>\n</select>\n</div>\n<div data-for=\"appointment request date\" class=\"col-lg-6 col-md-12 col-sm-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"appointment request date\" class=\"form-control-label mbr-fonts-style\">Appointment Request</label>\n<input type=\"date\" name=\"appointment request date\" data-form-field=\"appointment request date\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"2018-07-22\">\n</div>\n<div data-for=\"Appointment request time\" class=\"col-lg-6 col-md-12 col-sm-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Appointment request time\" class=\"form-control-label mbr-fonts-style\">Time</label>\n<input type=\"time\" name=\"Appointment request time\" max=\"86400\" min=\"0\" step=\"1800\" data-form-field=\"Appointment request time\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"10:00\">\n</div>\n<div data-for=\"Completion Date\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Completion Date\" class=\"form-control-label mbr-fonts-style\">How soon would you like to see your project completed?</label>\n<input type=\"date\" name=\"Completion Date\" data-form-field=\"Completion Date\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value=\"2018-07-22\">\n</div>\n<div class=\"col-lg-12 col-md-12 col-sm-12 form-group\" data-for=\"Project details\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"Project details\" class=\"form-control-label mbr-fonts-style\">Please describe your project with as much detail as possible.</label>\n<textarea name=\"Project details\" placeholder data-form-field=\"Project details\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\"></textarea>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-auto\">\n<a data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 w-100 btn btn-primary\">Submit</a>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n        </div>\n    </div>\n</section>",
          "_cid": "t4NmOg9Wxk",
          "_anchor": "formbuilder-3u",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "header9",
          "_sourceTheme": "appm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".row": {
              "align-items": "center"
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".header-text": {
              "width": "100%",
              "margin-bottom": "40px",
              "@media (max-width: 767px)": {
                "margin-bottom": "20px"
              }
            },
            ".mbr-section-title": {
              "width": "100%",
              "color": "#111111",
              "margin-bottom": "8px"
            },
            ".mbr-text": {
              "color": "#555555",
              "width": "100%",
              "margin-bottom": "0"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header9\" group=\"Header\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"\">\n            <input type=\"color\" title=\"Color\" value=\"#c4c4c8\" selected=\"\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#111111\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <div class=\"header-text\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style align-center\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                            <b>What Our Clients Are Saying</b></h2>\n                        <p class=\"mbr-text mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            No hidden fees, no limits\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "header9-3x",
          "_isUserblock": true,
          "_cid": "t4NvXt2aPl",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "testimonials03",
          "_sourceTheme": "labm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".carousel-item": {
              "justify-content": "center"
            },
            ".carousel-item.active, .carousel-item-next, .carousel-item-prev": {
              "display": "flex"
            },
            ".carousel-controls": {
              "a": {
                "transition": "opacity 0.5s",
                "font-size": "40px",
                "position": "absolute",
                "top": "80px",
                "bottom": "auto",
                "height": "60px",
                "width": "60px",
                "padding": "10px",
                "color": "gray",
                ".mbr-iconfont": {
                  "font-weight": "800"
                }
              }
            },
            ".carousel-control-next": {
              "span": {
                "padding-left": "5px"
              }
            },
            ".carousel-control-prev": {
              "span": {
                "padding-right": "5px"
              }
            },
            ".user_image": {
              "width": "200px",
              "height": "200px",
              "margin-bottom": "1.6rem",
              "overflow": "hidden",
              "border-radius": "50%",
              "margin": "0 auto 2rem auto",
              "img": {
                "width": "100%",
                "min-width": "100%",
                "min-height": "100%"
              }
            },
            "@media (max-width: 230px)": {
              ".user_image": {
                "width": "100%",
                "height": "auto"
              }
            },
            ".user_desk": {
              "color": "#ebeff2"
            },
            ".user_name": {
              "color": "#ebeff2"
            },
            ".user_text": {
              "color": "#ebeff2"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"testimonails3 carousel slide testimonials-slider\" group=\"Testimonials\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\" data-bs-interval=\"false\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" inline=\"\">\n        <input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" inline=\"\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked=\"\">\n        <input type=\"checkbox\" title=\"Status\" name=\"showDesk\" checked=\"\">\n        <header>Slides</header>\n        <input type=\"range\" inline=\"\" title=\"Items\" name=\"testimonialsSlides\" min=\"1\" max=\"20\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"8\" step=\"1\" value=\"3\" condition=\"showAutoplay\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#8b0000\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"text-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h3 class=\"mb-4 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n            <b>What Our Fantastic Users Say</b>\n        </h3>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-bs-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval*1000 : 'false'}}\" data-bs-interval=\"{{showAutoplay ? interval*1000 : 'false'}}\">\n            <div mbr-list=\"\" mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-8\">\n                        <div class=\"user_text mb-4\">\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\">\"MSG Painting did an excellent job in painting the exterior trim on our home. They were prompt and professional and delivered on every detail, including some minor trim repairs.  I would call them again and would certainly recommend them to friends and neighbors.\"</p>\n                        </div>\n                        <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Lori Hancock</b></div>\n                        <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">MSG Customer</div>\n                    </div>\n                </div>\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-8\">\n                        <div class=\"user_text mb-4\">\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\">\"MSG did a wonderful job. They were on time and finished in just two days. They didn't leave a mess and the house looked great!!! Thank you so much for a job well done.... and at a fair price.\"</p>\n                        </div>\n                        <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Mike and Leslie Rometty</b></div>\n                        <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">\n                            MSG Customer</div>\n                    </div>\n                </div>\n            <div class=\"carousel-item\">\n                    <div class=\"user col-md-8\">\n                        <div class=\"user_text mb-4\">\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".user_text\">\"You guys were great to work with.  You provided me a quote in a timely manner, and you worked with me on my budget.  You were able to paint the house within a few weeks, which was very convenient for my renter's.  I would definitely suggest you guys to everyone!\"</p>\n                        </div>\n                        <div mbr-text=\"\" class=\"user_name mbr-fonts-style mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showName\" data-app-selector=\".user_name\"><b>Kim Bolin</b></div>\n                        <div mbr-text=\"\" class=\"user_desk mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">\n                            MSG Customer</div>\n                    </div>\n                </div></div>\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                    <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\"></span>\n                    <span class=\"sr-only visually-hidden\">Previous</span>\n                </a>\n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                    <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\"></span>\n                    <span class=\"sr-only visually-hidden\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "testimonials03-3y",
