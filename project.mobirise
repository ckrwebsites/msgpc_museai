                "videoUrl": "https://www.youtube.com/watch?v=fwkKc6M60-0",
                "image": "@PROJECT_PATH@/assets/images/img-4988-2000x1332.jpeg",
                "thumb": "@PROJECT_PATH@/assets/images/img-4988-2000x1332-800x611.jpeg",
