            },
            ".image": {
              "margin-top": "30px",
              "max-width": "200px",
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            },
            "@media (max-width: 991px)": {
              ".row > [class*=\"col\"]": {
                "padding-left": "1rem",
                "padding-right": "1rem"
              },
              ".footer_col_logo": {
                "width": "100%"
              },
              ".footer_col": {
                "width": "33.3%"
              },
