              "width": "20%"
            },
            ".list": {
              "list-style": "none",
              "padding": "0",
              "margin": "0",
              "color": "#730707"
            },
            ".logo_wrap": {
              "max-width": "(@logoSize * 15%)",
              "img": {
                "width": "100%",
                "max-height": "300px"
              }
            },
