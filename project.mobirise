                "padding-top": "1.5rem"
              },
              ".nav-item": {
                "&:before": {
                  "content": "none"
                }
              },
              ".navbar": {
                "padding": "0"
              },
              ".menu-bottom": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column"
              },
              "button.navbar-toggler": {
                "-webkit-align-self": "center",
                "align-self": "center"
              }
            }
          },
          "_name": "menu1",
          "_sourceTheme": "therapym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu therapym4_manu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe, mobirise-icons\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <select title=\"Icons Count\" name=\"widgetCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Size</header>\n        <input type=\"range\" title=\"Logo\" inline name=\"logoSize\" min=\"2\" max=\"8\" step=\"0.5\" value=\"3.5\" condition=\"showLogo\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#200960\">\n        <input type=\"color\" title=\"Top Menu\" name=\"menutopColor\" value=\"#730707\">\n        <input type=\"color\" title=\"Icons Color\" name=\"iconColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Menu\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Dropdown\" name=\"drColor\" value=\"#ffffff\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown align-items-center\" mbr-class=\"{'navbar-fixed-top': sticky,\n        'navbar-toggleable-sm': !collapsed,\n        'collapsed': collapsed,\n        'bg-color transparent': transparent}\">\n        <div class=\"menu-content-top\">\n            <div class=\"menu-content-left\">\n                <div class=\"info-widget\">\n                    <a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-map-pin mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"location-title mbr-fonts-style\" data-app-selector=\".location-title\" mbr-theme-style=\"display-4\"><br><a href=\"https://www.google.com/maps/place/4327+S+Hwy+27+%23250,+Clermont,+FL+34711,+USA/@28.5014938,-81.7173428,79m/data=!3m1!1e3!4m6!3m5!1s0x88e788c61857549b:0xfb8875aaadcbae8d!8m2!3d28.5015611!4d-81.7172865!16s%2Fg%2F11sn00gy_x\" class=\"text-white text-primary\" target=\"_blank\">4327 S. Highway 27, Suite 250, Clermont, FL 34711&nbsp;</a></p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"menu-content-right\">\n                <div class=\"info-widget\">\n                    <a href=\"mailto:sales@msgpc.com\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-letter mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"mailto:sales@msgpc.com\" class=\"text-warning\">sales@msgpc.com</a></p>\n                    </div>\n                </div>\n                <div class=\"info-widget\">\n                    <a href=\"tel:+1-352-3633263\"><span mbr-icon class=\"widget-icon mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \"></span></a>\n                    <div class=\"widget-content\" mbr-theme-style=\"display-4\">\n                        <p class=\"widget-title mbr-fonts-style\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-4\"><a href=\"tel:+1-352-3633263\" class=\"text-white\">352.363.3263</a></p>\n                    </div>\n                </div>\n\n                <div class=\"icon-wrap\">\n                    <a href=\"https://www.facebook.com/MSGPaintingConstruction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon\" style=\"\n                            color: rgb(158, 158, 158);\n                            fill: rgb(158, 158, 158);\n                        \" mbr-if=\"widgetCount > 0\"></span></a>\n                    <a href=\"https://www.instagram.com/msgpainting/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-instagram mobi-mbri-add-submenu mobi-mbri\" style mbr-if=\"widgetCount > 1\"></span></a>\n                    <a href=\"https://www.youtube.com/user/mnsgardner?reload=9\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-facebook socicon-youtube socicon\" style mbr-if=\"widgetCount > 2\"></span></a>\n                    <a href=\"https://www.linkedin.com/company/msg-painting-construction/\" target=\"_blank\"><span mbr-icon class=\"widget-icon mbr-iconfont socicon-linkedin socicon\" style mbr-if=\"widgetCount > 3\"></span></a>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"menu-bottom\">\n            <div class=\"menu-logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"navbar-brand\">\n                    <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                        <a href=\"https://mobiri.se\">\n                            <img src=\"@ADDONS_PATH@/therapym4/components/_images/logo2.png\" alt=\"Mobirise\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                        </a>\n                    </span>\n                    <span mbr-if=\"showBrand\" mbr-theme-style=\"display-7\" mbr-buttons class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\">\n                        <a href=\"https://mobiri.se\" class=\"brand-name mbr-black text-black mbr-bold\" data-app-selector=\".brand-name\" data-app-placeholder=\"Type Text\">\n                            TherapyM4\n                        </a>\n                    </span>\n                </div>\n            </div>\n\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown js-float-line\" mbr-theme-style=\"display-4\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                            HOME\n                        </a>\n                    </li>\n                    <li class=\"nav-item\">\n                        <a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/about.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ABOUT</a>\n                    </li>\n\n                    \n\n                    <li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/services.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PAINTING</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/testimonials.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">TESTIMONIALS</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/photo-gallery.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">OUR WORK</a></li><li class=\"nav-item\"><a class=\"nav-link link mbr-black text-black text-primary\" href=\"https://msgpc.com/media.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">MEDIA</a></li></ul>\n\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-primary\" href=\"bid-request.html\" data-app-placeholder=\"Type Text\">REQUEST ESTIMATE</a></div>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n        </div>\n    </nav>\n</section>",
          "_cid": "ttfIAn4jN3",
          "_anchor": "menu1-ke",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "aheader1",
          "_sourceTheme": "factm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1 factm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"0.4\" max=\"1\" value=\"0.5\" step=\"0.1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title 1\" name=\"showTitle1\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title 2\" name=\"showTitle2\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText1\">\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText2\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/factm5/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#FFFFFF\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/factm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"content-container\">\n            <div class=\"item-left\" mbr-if=\"showTitle1 || showSubtitle || showTitle2\">\n                <h1 class=\"mbr-section-title mbr-section-title1 mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title1\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle1\">\n                    Imagine.\n                </h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-1\" mbr-if=\"showSubtitle\"><br>Media Presence and Credibility</h2>\n                <h2 class=\"mbr-section-title mbr-section-title2 mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title2\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle2\">\n                    Permit.\n                </h2>\n            </div>\n            <div class=\"item-right\" mbr-if=\"showText1 || showText2 || showButtons\">\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText1\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Eget nunc scelerisque viverra mauris in. Sed augue lacus viverra vitae congue porttit.\n                </p>\n                <div class=\"item-right-bottom-wrap\" mbr-if=\"showText2 || showButtons\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText2\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        We are humbled and honored when we are recognized for our hard work and efforts. In the many years we have been in business, we have been acknowledged a number of times in magazines, news articles and flyers to be the best in our field and an example to be followed. \n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"tel:+1-352-3633263\" data-app-placeholder=\"Type Text\">Call Now!</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-container": {
              "display": "grid",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "75px",
              "grid-row-gap": "75px",
              "-ms-grid-columns": "1fr 0.5fr",
              "grid-template-columns": "1fr ~\"@{textWidth}fr\"",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto",
              "@media (max-width: 1259px)": {
                "grid-template-columns": "1fr 0.25fr"
              },
              "@media (max-width: 991px)": {
                "grid-template-columns": "1fr",
                "grid-row-gap": "50px"
              },
              "@media (max-width: 767px)": {
                "grid-row-gap": "16px"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#730707",
              "padding": "16px 0",
              "font-weight": "400",
              "b": {
                "font-weight": "700"
              },
              "@media (max-width: 767px)": {
                "padding": "12px 0"
              }
            },
            ".item-right": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "align-items": "stretch",
              "padding-top": "60px",
              "@media (max-width: 991px)": {
                "padding-top": "0"
              }
            },
            ".mbr-text": {
              "margin-bottom": "10px",
              "color": "#747474"
            },
            ".mbr-section-btn": {
              "margin-top": "30px",
              ".btn": {
                "min-width": "50px"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_cid": "tur1yTObi9",
          "_anchor": "aheader1-nb",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content5",
          "_sourceTheme": "claimm4",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card-wrapper": {
              "background-color": "@borderColor",
              "padding": "2rem",
              "@media (max-width: 767px)": {
                "padding": "1rem"
              }
            },
            ".text-wrapper": {
              "max-width": "28rem"
            },
            ".content-wrapper": {
              "background": "@cardColor",
              "@media (max-width: 991px)": {
                ".image-wrapper": {
                  "margin-bottom": "2rem"
                }
              },
              "@media (max-width: 767px)": {
                "padding": "1rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2rem"
              },
              "@media (min-width: 992px)": {
                "padding": "3rem",
                ".text-column": {
                  "padding-left": "4rem"
                }
              }
            },
            "& when (@rowReverse)": {
              ".row": {
                "flex-direction": "row-reverse"
              },
              "@media (min-width: 992px)": {
                ".text-column": {
                  "padding-left": "16px !important",
                  "padding-right": "4rem"
                }
              }
            },
            ".image-wrapper img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".card-title": {
              "text-align": "center"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content5\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n         <input type=\"checkbox\" title=\"Reverse\" name=\"rowReverse\" checked>\n        <input type=\"range\" name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#8b0000\" selected>\n        <input type=\"color\" title=\"Card Color\" name=\"cardColor\" value=\"#ffffff\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/bg-3.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"card-wrapper\">\n        <div class=\"content-wrapper\">\n            <div class=\"row align-items-center\">\n                <div class=\"col-12 col-lg-{{imageWidth}}\">\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/whatsapp-image-2023-01-20-at-10.16.00-am-731x1024.jpg\" alt=\"Mobirise\">\n                    </div>\n                </div>\n                <div class=\"col-12 col-lg text-column\">\n                    <div class=\"text-wrapper\">\n                        <h6 class=\"card-title mbr-fonts-style mb-3 mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Residential, Commercial &amp; New Construction</h6>\n                        <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Making our mark in Clermont, Florida, we are ready to help you with your next home or commercial project. We offer FREE estimates and can provide services like Interior and Exterior painting, pressure washing &amp; soft washing and more. <a href=\"tel:+1-352-3633263\" class=\"text-primary\">Give us a call</a> for your FREE estimate!</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-primary btn-md\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                Learn more\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content5-n6",
          "_isUserblock": true,
          "_cid": "ttMl1ViK4r",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
