            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title": {
              "width": "100%",
              "text-align": "center",
              "margin-bottom": "24px",
              "line-height": "1.171em",
              "color": "#14142b"
            },
            ".mbr-text": {
              "color": "#8c8c95",
              "margin-bottom": "26px",
              "text-align": "center"
            },
            ".button-align": {
              "text-align": "center"
            },
            ".mbr-section-btn": {
              "display": "block"
