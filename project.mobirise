    "testimonials.html": {
      "settings": {
        "title": "MSG Painting & Construction - Testimonials",
        "order": 58,
        "meta_descr": "We at MSG Painting & Construction exceed our customers expectations with every finished project. See what our customers have to say about us."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            ".navbar": {
              "padding": "0.5rem 0",
              "background": "@menuBgColor",
              "transition": "none",
              "min-height": "50px"
            },
            ".navbar-fixed-top": {
              "padding-top": "0"
            },
            ".navbar-collapse": {
              "-ms-flex-preferred-size": "auto",
              "-webkit-flex-basis": "auto",
              "flex-basis": "auto"
            },
            ".collapse": {
              "justify-content": "space-between !important"
            },
            ".icon-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "1rem"
            },
            ".mbr-iconfont": {
              "cursor": "pointer"
            },
            ".nav-item": {
              "position": "relative",
              "letter-spacing": "2px",
              "font-weight": "200",
              "&:before": {
                "position": "absolute",
                "left": "0px",
                "top": "50%",
                "content": "''",
                "transform": "translateY(-50%)",
                "width": "8px",
                "height": "8px",
                "opacity": "0.5",
                "background": "@primaryColor",
                "border-radius": "50%"
              },
              "& span": {
                "padding-right": "0.4em",
                "line-height": "0.5em",
                "vertical-align": "text-bottom",
                "position": "relative",
                "top": "-0.2em",
                "text-decoration": "none"
              }
            },
            ".location-title": {
              "margin": "0",
              "color": "#ffffff"
            },
            ".menu-logo": {
              ".navbar-brand": {
                "display": "flex",
                "margin-left": "1.5rem",
                "padding": "0.5rem 0",
                "transition": "padding 0.2s",
                "transform-origin": "top",
                "min-height": "3.8rem",
                "-webkit-align-items": "center",
                "align-items": "center",
                ".navbar-caption-wrap": {
                  "display": "flex",
                  "-webkit-align-items": "center",
                  "align-items": "center",
                  "word-break": "break-word",
                  "min-width": "7rem",
                  "margin": "0.3rem 0",
                  ".navbar-caption": {
                    "line-height": "1.2rem !important",
                    "padding-right": "2rem"
                  }
                },
                ".navbar-logo": {
                  "font-size": "4rem",
                  "transition": "font-size 0.25s",
                  "& img": {
                    "display": "flex",
                    "width": "auto"
